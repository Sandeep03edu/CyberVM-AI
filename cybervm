#!/usr/bin/env bash
# cybervm — CyberVM Kali platform control CLI
# See docs/runbook/00-master-plan.md for the full plan.
set -euo pipefail

# Resolve through a symlink (e.g. /usr/local/bin/cybervm on PATH) so CYBERVM_HOME
# always points at the real repo, not the symlink's directory. host-setup installs
# that symlink (see lib/host.sh _host_cli_link), letting `cybervm` run from anywhere.
CYBERVM_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CYBERVM_HOME="$(cd "$(dirname "$CYBERVM_SELF")" && pwd)"
export CYBERVM_HOME

# shellcheck source=lib/common.sh
source "$CYBERVM_HOME/lib/common.sh"
load_env

usage() {
  cat <<USAGE
cybervm — control CLI for the CyberVM Kali platform

HOST SETUP
  host-setup                 Install/configure host (VirtualBox net, Ollama, deps, ufw).
                             Also symlinks this CLI onto PATH, so after the first
                             (./cybervm host-setup) run you can type 'cybervm ...' anywhere.
  host setup|ollama-pin      host-setup alias; refresh the pinned Ollama release from GitHub
  doctor                     Print a PASS/FAIL readiness table
  pins check                 Verify pinned downloads (Burp BApp serials) vs live store
  pins refresh               Re-pin drifted Burp extensions (serial + sha256)

IMAGES
  base import                Extract + register the verified Kali image as CyberVM-Kali-Base
  golden build               Clone base -> provision with Ansible -> snapshot golden-<date>
  golden verify              Re-run Ansible in check mode + SSH smoke tests
  golden reset [--keep-ova]  Delete golden + its snapshot chain, rebuild from base.
                             Caps the chain (~1.3GB per build, never pruned) at one
                             snapshot. Base is never touched, so a failed reset is
                             recoverable with: golden build. Flags: --keep-ova export
                             a .ova first, --dry-run show the plan, --no-verify skip tests
  release                    Export golden snapshot to an .ova (+ sha256 + manifest)
  release list|rm|prune      Inspect / delete / trim exported .ova releases
  import <file.ova>          Register an exported .ova on this machine

VM LIFECYCLE
  new <name> [--profile P | --ram GB] [--cpus N]
                             Linked clone of the golden snapshot. Profiles (config/platform.yml):
                             lean 8GB/4 - balanced 12GB/6 (default) - large 16GB/8. --ram takes 12,
                             12G or 12288M; --cpus defaults to the same 1:2 ratio (12GB -> 6).
                             New clones are ALWAYS offline — no --net here. Give it a
                             network at start: start <name> --net nat|bridged|airgap
  resize <name> [--ram GB] [--cpus N]
                             Change RAM/vCPU on an existing clone (VM must be off). Sizing is a
                             .vbox property, so the golden image is never modified.
  start <name> [--net MODE] [--headless]
  stop <name>                ACPI shutdown
  net <name> <MODE>          Set network mode (offline|airgap|nat|bridged); VM must be off
  snapshot <name> <tag>      Take a snapshot
  restore <name> <tag>       Restore a snapshot
  destroy <name>             Power off + delete a clone (never Base/Golden)
  list                       List CyberVM VMs and state
  clipboard/DnD              Declared in config/platform.yml (.vm_defaults) and applied
                             automatically on base import, golden build and every clone.
                             Read-only drift check: ./cybervm doctor

MCP (in-VM guest CLI, not a host command)
  cybervm mcp status         Baked MCP server + browser versions (offline-safe)
  cybervm mcp verify         Offline health check of the baked browser
  cybervm mcp update         Refresh MCP servers to latest (needs net nat|bridged)
  The Playwright MCP is headed-only, so a clone must be started with a GUI
  session (not --headless) for the browser window to be visible.

AI (host-native Ollama)
  ai pull|list|rm|bench      Manage/benchmark local models
  ai run <prompt>            Send a prompt to a local model and stream the reply
  ai tune|untune             Apply/revert coexistence tuning for host Ollama

RAG (host docker service)
  rag up|down|status         Manage the RAG stack
  rag update [stable|live]   Ingest/refresh knowledge
  rag backup|restore         Snapshot / restore the vector DB

TRANSFER / SECRETS
  transfer in|out <vm> <file>   Controlled host<->VM file copy
  secrets push <vm> [names..]   Copy named API keys into VM tmpfs
  secrets wipe <vm>             Remove pushed secrets

  backup <dest>              Back up source + releases + rag snapshot to <dest>
  help                       This message
USAGE
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  host-setup)  source "$CYBERVM_HOME/lib/host.sh";     host_setup "$@" ;;
  host)        source "$CYBERVM_HOME/lib/host.sh";     host_cmd "$@" ;;
  doctor)      source "$CYBERVM_HOME/lib/doctor.sh";   doctor "$@" ;;
  pins)        source "$CYBERVM_HOME/lib/pins.sh";     pins_dispatch "$@" ;;
  base|golden|release|import|new|resize|start|net|ai|rag|transfer|secrets|backup)
               require_host_setup
               case "$cmd" in
                 base)     source "$CYBERVM_HOME/lib/base.sh";      base_dispatch "$@" ;;
                 golden)   source "$CYBERVM_HOME/lib/golden.sh";    golden_dispatch "$@" ;;
                 release)  source "$CYBERVM_HOME/lib/release.sh";   release_dispatch "$@" ;;
                 import)   source "$CYBERVM_HOME/lib/release.sh";   release_import "$@" ;;
                 new)      source "$CYBERVM_HOME/lib/vm.sh";        vm_dispatch new "$@" ;;
                 resize)   source "$CYBERVM_HOME/lib/vm.sh";        vm_dispatch resize "$@" ;;
                 start)    source "$CYBERVM_HOME/lib/vm.sh";        vm_dispatch start "$@" ;;
                 net)      source "$CYBERVM_HOME/lib/net.sh";       net_set "$@" ;;
                 ai)       source "$CYBERVM_HOME/lib/ai.sh";        ai_dispatch "$@" ;;
                 rag)      source "$CYBERVM_HOME/lib/rag.sh";       rag_dispatch "$@" ;;
                 transfer) source "$CYBERVM_HOME/lib/transfer.sh";  transfer_dispatch "$@" ;;
                 secrets)  source "$CYBERVM_HOME/lib/secrets.sh";   secrets_dispatch "$@" ;;
                 backup)   source "$CYBERVM_HOME/lib/release.sh";   backup_run "$@" ;;
               esac
               ;;
  stop|snapshot|restore|destroy|list)
               source "$CYBERVM_HOME/lib/vm.sh";       vm_dispatch "$cmd" "$@" ;;
  help|-h|--help) usage ;;
  *) err "unknown command: $cmd"; usage; exit 2 ;;
esac
