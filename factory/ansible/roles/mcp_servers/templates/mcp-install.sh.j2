#!/usr/bin/env bash
# cyberai-mcp-install — install / refresh the MCP servers declared in
# /etc/cyberai/mcp-install.plan (rendered from config/mcp/servers.yml by the
# mcp_servers role at golden-build time).
#
# This script is deliberately static: the manifest data lives in a separate plan
# file so the same binary works in three places without templating —
#   * `bake`    — called by the mcp_servers Ansible role during `golden build`
#   * `update`  — called by `cyberai mcp update` from inside a clone
#   * `status` / `verify` — read-only, `verify` works fully offline
#
# Baked browsers live in a shared, world-readable path so every linked clone
# inherits them via copy-on-write at ~zero marginal cost. `verify` is the
# offline health check: everything except `update` works with no network.
#
#   cyberai-mcp-install bake [--force]   install per plan (no-op if already baked)
#   cyberai-mcp-install update           refresh packages+browsers to latest (needs net)
#   cyberai-mcp-install status           show versions; diff vs registry if reachable
#   cyberai-mcp-install verify           offline health check
set -euo pipefail

PLAN=/etc/cyberai/mcp-install.plan
LOCK=/etc/cyberai/mcp.lock
# Absolute path to this script. Callers run it as `sudo cyberai-mcp-install`,
# where a bare name can fail because sudo resets PATH via secure_path - so
# resolve once here and always invoke/compare using an absolute path.
SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"

say()  { printf '\033[1;32m[mcp]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[mcp]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[mcp]\033[0m %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

_root() { [ "$(id -u)" -eq 0 ] || die "needs root — run: sudo "$SELF" ${1:?}"; }

_plan() { [ -f "$PLAN" ] || die "missing $PLAN — this image has no MCP manifest; rebuild golden (mcp_servers role)."; }

# @playwright/mcp needs Node >= 18. The common role installs unpinned distro
# nodejs, so this is asserted rather than assumed.
require_node() {
  command -v node >/dev/null 2>&1 || die "node not found — the common role installs nodejs/npm."
  command -v npm  >/dev/null 2>&1 || die "npm not found — the common role installs nodejs/npm."
  local v major
  v="$(node --version)"
  major="${v#v}"; major="${major%%.*}"
  case "$major" in ''|*[!0-9]*) die "cannot parse node version '$v'.";; esac
  [ "$major" -ge 18 ] || die "node $v is too old — @playwright/mcp requires Node >= 18."
}

# npm links only the DIRECT dependency's bins into the global prefix, so the
# `playwright` CLI (a transitive dep of @playwright/mcp) is NOT on PATH.
# Resolve it explicitly instead of assuming.
resolve_pw_cli() {
  local root c
  root="$(npm root --global 2>/dev/null)" || return 1
  for c in "$root/playwright/cli.js" \
           "$root/@playwright/mcp/node_modules/playwright/cli.js"; do
    [ -f "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  c="$(find "$root" -maxdepth 5 -type f -path '*/playwright/cli.js' 2>/dev/null | head -1 || true)"
  [ -n "$c" ] && { printf '%s\n' "$c"; return 0; }
  return 1
}

pkg_version() { # <package> -> installed version, or "unknown"
  local root
  root="$(npm root --global 2>/dev/null)" || { echo unknown; return; }
  node -e "try{process.stdout.write(require('$root/$1/package.json').version)}catch(e){process.stdout.write('unknown')}" 2>/dev/null || echo unknown
}

_browser_dirs() { # <browsers_path> <browser> -> one dir name per line
  ls -1d "$1/$2"-*/ 2>/dev/null | sed 's#/*$##' || true
}

_marker() { echo "$1/.cyberai-baked"; }

_install_pkg() { # <package> <version>
  local spec="$1"
  [ "$2" != "latest" ] && spec="$1@$2"
  say "npm install -g $spec (no browser download)"
  # PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD is mandatory, not an optimisation: the
  # `playwright` package postinstall would otherwise pull a second copy of the
  # browser into /root/.cache, unreadable by the kali user.
  env PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install -g "$spec" --no-fund --no-audit
}

_install_browser() { # <browsers_path> <browser> <no_shell:true|false> <with_deps:true|false>
  local path="$1" browser="$2" no_shell="$3" with_deps="$4" cli
  cli="$(resolve_pw_cli)" || die \
    "could not locate playwright/cli.js under $(npm root --global) — is @playwright/mcp installed? Try: cyberai mcp update"
  local args=(install)
  [ "$with_deps" = true ] && args+=(--with-deps)
  args+=("$browser")
  # Headed-only: never fetch the separate headless-shell build.
  [ "$no_shell" = true ] && args+=(--no-shell)
  say "playwright ${args[*]} -> $path"
  # PLAYWRIGHT_BROWSERS_PATH MUST be identical here and in the wrapper, or the
  # runner looks for a browser the installer never wrote ("executable doesn't
  # exist"). SKIP_BROWSER_GC stops Playwright garbage-collecting a baked build
  # it believes is unused.
  env PLAYWRIGHT_BROWSERS_PATH="$path" PLAYWRIGHT_SKIP_BROWSER_GC=1 \
    node "$cli" "${args[@]}"
  chmod -R a+rX "$path"
  touch "$(_marker "$path")"
}

_write_lock() { # <browsers_path> <browser> <package>
  local path="$1" browser="$2" pkg="$3" cli pw_v dirs
  cli="$(resolve_pw_cli || true)"
  pw_v=unknown
  [ -n "$cli" ] && pw_v="$(node "$cli" --version 2>/dev/null || echo unknown)"
  dirs="$(_browser_dirs "$path" "$browser" | tr '\n' ' ')"
  {
    echo "# Written by cyberai-mcp-install. The reproducibility anchor for this image."
    echo "generated=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "node=$(node --version 2>/dev/null || echo unknown)"
    echo "npm=$(npm --version 2>/dev/null || echo unknown)"
    echo "package=$pkg"
    echo "package_version=$(pkg_version "$pkg")"
    echo "playwright_cli=$pw_v"
    echo "browsers_path=$path"
    echo "browser_builds=${dirs:-none}"
  } > "$LOCK"
  say "recorded resolved versions in $LOCK"
}

cmd_bake() { # [--force]
  _root bake; _plan; require_node
  local force=false
  [ "${1:-}" = "--force" ] && force=true
  local line name pkg bin ver path browser no_shell
  while IFS='|' read -r name pkg bin cmdpath ver path browser no_shell; do
    [ -n "${name:-}" ] || continue
    case "$name" in \#*) continue;; esac
    if [ "$force" != true ] && [ -f "$(_marker "$path")" ]; then
      say "$name already baked at $path — skipping (use cyberai mcp update, or '$SELF bake --force' to re-bake)."
      continue
    fi
    _install_pkg "$pkg" "$ver"
    _install_browser "$path" "$browser" "$no_shell" true
    _write_lock "$path" "$browser" "$pkg"
    say "$name baked."
  done < "$PLAN"
}

cmd_update() {
  _root update; _plan; require_node
  local line name pkg bin ver path browser no_shell
  while IFS='|' read -r name pkg bin cmdpath ver path browser no_shell; do
    [ -n "${name:-}" ] || continue
    case "$name" in \#*) continue;; esac
    # System libs (--with-deps) are baked once; refreshing them on every update
    # is minutes of apt for no benefit, so update skips them.
    say "refreshing $name (system deps skipped — unchanged since bake)"
    _install_pkg "$pkg" "$ver"
    _install_browser "$path" "$browser" "$no_shell" false
    _write_lock "$path" "$browser" "$pkg"
  done < "$PLAN"
  say "update complete. Verify with: cyberai mcp verify"
}

cmd_status() {
  _plan
  if [ -f "$LOCK" ]; then cat "$LOCK"; else warn "no $LOCK yet — cyberai-mcp-install has not run in this image."; fi
  echo
  local line name pkg bin ver path browser no_shell
  while IFS='|' read -r name pkg bin cmdpath ver path browser no_shell; do
    [ -n "${name:-}" ] || continue
    case "$name" in \#*) continue;; esac
    echo "  $name"
    printf '    installed   %s\n' "$(pkg_version "$pkg")"
    printf '    path        %s\n' "$path"
    local d; d="$(_browser_dirs "$path" "$browser" | tr '\n' ' ')"
    printf '    browsers    %s\n' "${d:-none}"
    printf '    baked       %s\n' "$([ -f "$(_marker "$path")" ] && echo yes || echo no)"
    # Registry diff only when reachable; `status` must still work offline.
    if command -v timeout >/dev/null 2>&1; then
      local latest
      latest="$(timeout 20 npm view "$pkg" version 2>/dev/null || true)"
      if [ -n "$latest" ]; then
        printf '    registry    %s\n' "$latest"
        [ "$latest" = "$(pkg_version "$pkg")" ] || printf '    update      ./cyberai mcp update  (net nat|bridged)\n'
      else
        printf '    registry    unreachable (offline) — baked version still works\n'
      fi
    fi
  done < "$PLAN"
}

cmd_verify() { # fully offline
  _plan
  local rc=0 line name pkg bin ver path browser no_shell chrome
  say "offline verification"
  if command -v node >/dev/null 2>&1; then say "  node         $(node --version)"; else err "  node         MISSING"; rc=1; fi
  if command -v npm >/dev/null 2>&1;  then say "  npm          $(npm --version)";  else err "  npm          MISSING"; rc=1; fi
  while IFS='|' read -r name pkg bin cmdpath ver path browser no_shell; do
    [ -n "${name:-}" ] || continue
    case "$name" in \#*) continue;; esac
    echo
    say "  $name"
    if command -v "$bin" >/dev/null 2>&1; then say "    bin         $(command -v "$bin")"
    else err "    bin         MISSING ($bin) — run: cyberai mcp update"; rc=1; fi
    if [ -d "$path" ]; then
      say "    browsers    $path"
      # >&2 so the listing interleaves correctly with the say/err stream above.
      _browser_dirs "$path" "$browser" | sed 's#^#      #' >&2
    else
      err "    browsers    MISSING $path — run: cyberai mcp update"; rc=1
    fi
    chrome="$(ls -1d "$path"/"$browser"-*/chrome-linux*/chrome 2>/dev/null | head -1 || true)"
    if [ -z "$chrome" ]; then
      err "    chrome      no $browser build under $path"; rc=1
    elif [ -x "$chrome" ]; then
      say "    chrome      $chrome (executable by $(id -un))"
    else
      err "    chrome      $chrome NOT executable by $(id -un) — run: sudo chmod -R a+rX $path"; rc=1
    fi
    if [ -f "$(_marker "$path")" ]; then say "    baked       yes"
    else warn "    baked       marker missing ($(_marker "$path"))"; fi
  done < "$PLAN"
  echo
  # Wrapper must be able to read the same path the installer wrote.
  local w
  for w in $(cut -d'|' -f4 "$PLAN" 2>/dev/null | grep -E '^/' | sort -u); do
    if [ -x "$w" ]; then say "  wrapper      $w (executable)"
    else err "  wrapper      $w MISSING or not executable"; rc=1; fi
  done
  # Check the installer itself, not just what it installed. `cyberai mcp update`
  # is the one command that needs it, and the failure mode is opaque: sudo resets
  # PATH, so a bare name yields "command not found" even when the file is fine.
  if [ -x "$SELF" ]; then say "  installer    $SELF (executable)"
  else err "  installer    $SELF MISSING or not executable - mcp update will fail"; rc=1; fi
  echo
  if [ "$rc" -eq 0 ]; then say "OK — Playwright MCP is usable offline (GUI session required: the browser is headed-only)."; return 0; fi
  err "FAILED (rc=$rc) — see docs/runbook/09-troubleshooting.md"; return 1
}

usage() {
  cat <<EOF
cyberai-mcp-install — manage the MCP servers baked into this image.

  bake [--force]   Install per /etc/cyberai/mcp-install.plan. No-op when the
                   browsers marker already exists; --force re-bakes.  [root]
  update           Refresh packages + browsers to the latest release.
                   Skips OS deps (unchanged since bake).              [root, net]
  status           Show resolved versions; diff against the npm registry
                   when reachable.                            [no root, offline ok]
  verify           Offline health check of the baked browser + wrapper.

The browsers are shared read-only across linked clones (copy-on-write), so
status and verify work with no network at all.
EOF
}

case "${1:-}" in
  bake)    shift || true; cmd_bake "$@" ;;
  update)  shift || true; cmd_update "$@" ;;
  status)  shift || true; cmd_status "$@" ;;
  verify)  shift || true; cmd_verify "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; die "unknown subcommand: ${1:-<none>}" ;;
esac
