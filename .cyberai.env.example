# ── CyberAI platform local configuration (COPY to .cyberai.env) ──
# The ONLY thing that changes when you move to an SSD / new machine is CYBERAI_ROOT.

CYBERAI_ROOT="$HOME/Personal/CyberAIKaliVM"

# Derived data locations (normally leave as-is)
CYBERAI_DOWNLOADS="$CYBERAI_ROOT/downloads"
CYBERAI_IMAGES="$CYBERAI_ROOT/images"
CYBERAI_LABS="$CYBERAI_ROOT/labs"
CYBERAI_MODELS="$CYBERAI_ROOT/models"
CYBERAI_RAG="$CYBERAI_ROOT/rag"
CYBERAI_ARTIFACTS="$CYBERAI_ROOT/artifacts"
CYBERAI_BACKUPS="$CYBERAI_ROOT/backups"
CYBERAI_TRANSFER="$CYBERAI_ROOT/transfer"

# ── Networking: private host-only "AI plane" (must NOT collide with vboxnet0 = 192.168.56.x) ──
CYBERAI_NET_NAME="cyberai"
CYBERAI_HOST_IP="192.168.57.1"
CYBERAI_NET_CIDR="192.168.57.0/24"
CYBERAI_DHCP_LOWER="192.168.57.100"
CYBERAI_DHCP_UPPER="192.168.57.199"

# ── Service ports (bound to CYBERAI_HOST_IP only) ──
CYBERAI_OLLAMA_PORT="11434"
CYBERAI_RAG_PORT="8088"
CYBERAI_TRANSFER_PORT="8000"

# ── Host resource guard: never let host free RAM drop below this (MB) when starting a VM ──
CYBERAI_HOST_RESERVE_MB="6144"

# ── VM guest credentials (official Kali prebuilt image defaults) ──
CYBERAI_VM_USER="kali"
CYBERAI_VM_PASS="kali"

# ── SSH key used to provision VMs (generated by host-setup) ──
CYBERAI_SSH_KEY="$HOME/.config/cyberai/id_ed25519"

# ── Secrets file (cloud API keys; never committed, never baked into images) ──
CYBERAI_SECRETS="$HOME/.config/cyberai/secrets.env"
