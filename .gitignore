*.vdi
*.vmdk
*.vhd
*.qcow2
*.sav
*.nvram
*.vbox
*.vbox-prev
*.log

# ── Large binary artifacts ──────────────────────────────────
*.7z
*.ova
*.ovf
*.iso

# ── Downloaded Burp BApp bundles / extension binaries ───────
*.zip
*.jar

# ── Scratch / editor cruft ──────────────────────────────────
*.tmp
*~
*.swp
*.swo
node_modules/
.pytest_cache/
.mypy_cache/
factory/ansible/.ansible/

# ── Data directories (large / machine-local; NOT source) ────
downloads/
images/
labs/
models/
rag/data/
rag/backups/
transfer/
backups/
artifacts/
KaliImage/

# ── Burp projects ───────────────────────────────────────────
*.burp
*.burpsuite

