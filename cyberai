#!/usr/bin/env bash
# cyberai — CyberAI Kali platform control CLI
# See docs/runbook/00-master-plan.md for the full plan.
set -euo pipefail

CYBERAI_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CYBERAI_HOME

# shellcheck source=lib/common.sh
source "$CYBERAI_HOME/lib/common.sh"
load_env

usage() {
  cat <<USAGE
cyberai — control CLI for the CyberAI Kali platform

HOST SETUP
  host-setup                 Install/configure host (VirtualBox net, Ollama, deps, ufw)
  host setup|ollama-pin      host-setup alias; refresh the pinned Ollama release from GitHub
  doctor                     Print a PASS/FAIL readiness table
  pins check                 Verify pinned downloads (Burp BApp serials) vs live store
  pins refresh               Re-pin drifted Burp extensions (serial + sha256)

IMAGES
  base import                Extract + register the verified Kali image as CyberAI-Kali-Base
  golden build               Clone base -> provision with Ansible -> snapshot golden-<date>
  golden verify              Re-run Ansible in check mode + SSH smoke tests
  release                    Export golden snapshot to an .ova (+ sha256 + manifest)
  import <file.ova>          Register an exported .ova on this machine

VM LIFECYCLE
  new <name> [--profile P]   Linked clone of the golden snapshot (P: lite|standard|heavy)
  start <name> [--net MODE] [--headless]
  stop <name>                ACPI shutdown
  net <name> <MODE>          Set network mode (offline|airgap|nat|bridged); VM must be off
  snapshot <name> <tag>      Take a snapshot
  restore <name> <tag>       Restore a snapshot
  destroy <name>             Power off + delete a clone (never Base/Golden)
  list                       List CyberAI VMs and state

AI (host-native Ollama)
  ai pull|list|rm|bench      Manage/benchmark local models
  ai run <prompt>            Send a prompt to a local model and stream the reply
  ai tune|untune             Apply/revert coexistence tuning for host Ollama

RAG (host docker service)
  rag up|down|status         Manage the RAG stack
  rag update [stable|live]   Ingest/refresh knowledge
  rag backup|restore         Snapshot / restore the vector DB

TRANSFER / SECRETS
  transfer in|out <vm> <file>   Controlled host<->VM file copy
  secrets push <vm> [names..]   Copy named API keys into VM tmpfs
  secrets wipe <vm>             Remove pushed secrets

  backup <dest>              Back up source + releases + rag snapshot to <dest>
  help                       This message
USAGE
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  host-setup)  source "$CYBERAI_HOME/lib/host.sh";     host_setup "$@" ;;
  host)        source "$CYBERAI_HOME/lib/host.sh";     host_cmd "$@" ;;
  doctor)      source "$CYBERAI_HOME/lib/doctor.sh";   doctor "$@" ;;
  pins)        source "$CYBERAI_HOME/lib/pins.sh";     pins_dispatch "$@" ;;
  base|golden|release|import|new|start|net|ai|rag|transfer|secrets|backup)
               require_host_setup
               case "$cmd" in
                 base)     source "$CYBERAI_HOME/lib/base.sh";      base_dispatch "$@" ;;
                 golden)   source "$CYBERAI_HOME/lib/golden.sh";    golden_dispatch "$@" ;;
                 release)  source "$CYBERAI_HOME/lib/release.sh";   release_export "$@" ;;
                 import)   source "$CYBERAI_HOME/lib/release.sh";   release_import "$@" ;;
                 new)      source "$CYBERAI_HOME/lib/vm.sh";        vm_dispatch new "$@" ;;
                 start)    source "$CYBERAI_HOME/lib/vm.sh";        vm_dispatch start "$@" ;;
                 net)      source "$CYBERAI_HOME/lib/net.sh";       net_set "$@" ;;
                 ai)       source "$CYBERAI_HOME/lib/ai.sh";        ai_dispatch "$@" ;;
                 rag)      source "$CYBERAI_HOME/lib/rag.sh";       rag_dispatch "$@" ;;
                 transfer) source "$CYBERAI_HOME/lib/transfer.sh";  transfer_dispatch "$@" ;;
                 secrets)  source "$CYBERAI_HOME/lib/secrets.sh";   secrets_dispatch "$@" ;;
                 backup)   source "$CYBERAI_HOME/lib/release.sh";   backup_run "$@" ;;
               esac
               ;;
  stop|snapshot|restore|destroy|list)
               source "$CYBERAI_HOME/lib/vm.sh";       vm_dispatch "$cmd" "$@" ;;
  help|-h|--help) usage ;;
  *) err "unknown command: $cmd"; usage; exit 2 ;;
esac
