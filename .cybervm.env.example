# ── CyberVM platform local configuration (COPY to .cybervm.env) ──
# The ONLY thing that changes when you move to an SSD / new machine is CYBERVM_ROOT.

CYBERVM_ROOT="$HOME/Personal/CyberVM-AI"

# Derived data locations (normally leave as-is)
CYBERVM_DOWNLOADS="$CYBERVM_ROOT/downloads"
CYBERVM_IMAGES="$CYBERVM_ROOT/images"
CYBERVM_LABS="$CYBERVM_ROOT/labs"
CYBERVM_MODELS="$CYBERVM_ROOT/models"
CYBERVM_RAG="$CYBERVM_ROOT/rag"
CYBERVM_ARTIFACTS="$CYBERVM_ROOT/artifacts"
CYBERVM_BACKUPS="$CYBERVM_ROOT/backups"
CYBERVM_TRANSFER="$CYBERVM_ROOT/transfer"

# ── Networking: private host-only "AI plane" (must NOT collide with vboxnet0 = 192.168.56.x) ──
CYBERVM_NET_NAME="cybervm"
CYBERVM_HOST_IP="192.168.57.1"
CYBERVM_NET_CIDR="192.168.57.0/24"
CYBERVM_DHCP_LOWER="192.168.57.100"
CYBERVM_DHCP_UPPER="192.168.57.199"

# ── Service ports (bound to CYBERVM_HOST_IP only) ──
CYBERVM_OLLAMA_PORT="11434"
CYBERVM_RAG_PORT="8088"
CYBERVM_TRANSFER_PORT="8000"

# ── Host resource guard: never let host free RAM drop below this (MB) when starting a VM ──
CYBERVM_HOST_RESERVE_MB="6144"

# ── VM guest credentials (official Kali prebuilt image defaults) ──
CYBERVM_VM_USER="kali"
CYBERVM_VM_PASS="kali"

# ── SSH key used to provision VMs (generated by host-setup) ──
CYBERVM_SSH_KEY="$HOME/.config/cybervm/id_ed25519"

# ── Secrets file (cloud API keys; never committed, never baked into images) ──
CYBERVM_SECRETS="$HOME/.config/cybervm/secrets.env"
